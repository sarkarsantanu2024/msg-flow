# ============================================================
# MsgFlow — environment configuration
# Copy to .env and fill in. `pnpm dev` reads this file.
# ============================================================

# --- Database (Neon PostgreSQL) -----------------------------
# DATABASE_URL uses the pooled connection; DIRECT_URL the direct one
# (Prisma migrations require a direct, non-pooled connection).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/msgflow?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/msgflow?sslmode=require"

# --- Auth ---------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"
APP_URL="https://msg-flow.vercel.app"

# --- AI providers -------------------------------------------
# AI_PROVIDER: anthropic | openai | gemini | mock
# `mock` needs no API key and drives Demo Mode + tests deterministically.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Optional model overrides (sensible defaults are built in)
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_MODEL="gpt-4o"
GEMINI_MODEL="gemini-2.0-flash"

# --- WhatsApp worker ----------------------------------------
# The web app calls the worker at WHATSAPP_WORKER_URL; the worker posts
# messages back to APP_URL. Both directions authenticate with the shared secret.
WHATSAPP_WORKER_URL="http://localhost:4000"
WHATSAPP_WORKER_SECRET="replace-me-with-a-shared-worker-secret"

# --- Encryption ---------------------------------------------
# 32-byte key, base64 or hex encoded. Encrypts stored integration credentials.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-key"

# --- Google (Sheets / Drive OAuth) --------------------------
# Optional. Without these, the Google Sheets connector runs in mock mode.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Webhooks -----------------------------------------------
# Used to sign outbound webhook payloads (HMAC-SHA256, X-MsgFlow-Signature).
WEBHOOK_SECRET="replace-me-with-a-webhook-signing-secret"

# --- Storage ------------------------------------------------
# Local filesystem driver by default. Set STORAGE_DRIVER=s3 with the S3 vars
# for production (see docs/deployment.md).
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# --- Worker-only (apps/worker/.env) -------------------------
WORKER_PORT="4000"
WORKER_NAME="worker-local"
WORKER_SESSION_PATH="./.sessions"
HEARTBEAT_INTERVAL_MS="15000"
# Set to true on Linux/Docker where a system Chromium is provided
PUPPETEER_HEADLESS="true"
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"

# --- Misc ---------------------------------------------------
LOG_LEVEL="info"
NODE_ENV="development"
